//--------------------------- SETUP DEFINE DI AWAL --------------------------
//setup pin
#define led 2
#define buzzer 25
#define relay 26
#define button 19
#define pot 34
#define servoPin 23
#define trig 5
#define echo 18

//setup wifi
#define ssid "SSID WIFI" //ssid wifiku
#define password "PASS WIFI" //password wifi

//setup firebase
#define host "https://blbalblabla.firebaseio.com" //link database firebase
#define path1 "/uname/switch1.json" //path untuk switch 1
// #define path2 "/uname/switch2.json" //path untuk switch 2
// #define path3 "/uname/switch3.json" //path untuk switch 3

//setup thingspeak
#define api_key "apikeyblablbalblabl" //write api key thingspeak
